# Portal/BFF origin. Node guest authentication retains the official Better
# Auth session cookie in memory and sends it only to this origin.
AOMI_BASE_URL=http://127.0.0.1:3000

# Optional Pipeline example. Supplying all three builds and simulates one
# catalog operation; the example never commits it.
AOMI_PIPELINE_APP=
AOMI_PIPELINE_OPERATION=
AOMI_PIPELINE_ARGS={}
