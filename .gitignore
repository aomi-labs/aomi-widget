# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
.pnpm-store/
/.pnp
.playwright-cli/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/
.playwright-mcp/
.repowiki/
.fastembed_cache/
/aomi

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# generated registry build output
apps/landing/public/r/dist
apps/shadcn-registry/dist

# generated package JavaScript bundles
packages/*/dist/*.js
packages/*/dist/*.cjs
packages/*/dist/*.map

# package build output (bundles)
packages/*/dist

# typescript
*.tsbuildinfo
next-env.d.ts

**/.specstory/*
.env*.local
.kiro/
