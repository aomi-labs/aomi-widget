# Portal is the sole browser auth/account/BFF host. Landing calls it directly.
NEXT_PUBLIC_AOMI_PORTAL_URL=https://chat.aomi.dev

# Para is the Landing widget's selected auth provider.
NEXT_PUBLIC_PARA_API_KEY=
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Optional external-wallet connector used by the unified widget.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
