{
  "name": "@aomi-labs/widget-lib",
  "version": "1.4.3",
  "description": "Shadcn registry for the Aomi widget.",
  "type": "module",
  "main": "./package-dist/index.js",
  "module": "./package-dist/index.js",
  "types": "./package-dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./package-dist/index.d.ts",
      "import": "./package-dist/index.js"
    },
    "./aomi-frame": "./src/components/aomi-frame.tsx",
    "./control-bar": "./src/components/control-bar/index.tsx",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./components/assistant-ui/*": "./src/components/assistant-ui/*.tsx",
    "./components/control-bar/*": "./src/components/control-bar/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./providers/base-account": "./src/lib/wallet-kit/providers/base-account.tsx",
    "./providers/para": {
      "types": "./package-dist/providers/para.d.ts",
      "import": "./package-dist/providers/para.js"
    },
    "./providers/privy": {
      "types": "./package-dist/providers/privy.d.ts",
      "import": "./package-dist/providers/privy.js"
    },
    "./styles.css": "./package-dist/styles.css",
    "./themes/*.css": "./src/themes/*.css"
  },
  "files": [
    "src",
    "dist",
    "package-dist"
  ],
  "scripts": {
    "build": "pnpm run build:npm && pnpm run build:registry",
    "build:npm": "tsup && node scripts/build-package-css.mjs",
    "build:registry": "tsx scripts/build-registry.js",
    "clean:dist": "rm -rf dist package-dist"
  },
  "dependencies": {
    "@aomi-labs/client": "workspace:*",
    "@aomi-labs/react": "workspace:*",
    "@assistant-ui/react": "^0.14.0",
    "@assistant-ui/react-markdown": "^0.14.0",
    "@getpara/react-sdk": "2.19.0",
    "@privy-io/react-auth": "^2.0.0",
    "@privy-io/wagmi": "^1.0.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-standard-wallet-adapter-react": "1.1.4",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.90.10",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.0.0",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.22",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "vaul": "^1.1.2",
    "viem": "^2.47.11",
    "wagmi": "^2.19.5",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
