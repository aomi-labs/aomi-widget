{
  "name": "@aomi-labs/workbench",
  "version": "0.1.0",
  "description": "Smithers-powered terminal workbench for building Aomi apps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aomi-workbench": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean:dist": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "execa": "^9.6.0",
    "ink": "^7.1.0",
    "react": "^19.2.0",
    "smithers-orchestrator": "^0.26.1",
    "zod": "^4.3.6"
  }
}
