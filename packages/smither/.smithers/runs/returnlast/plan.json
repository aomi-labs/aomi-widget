{
  "app": "returnlast",
  "sdkRoot": "/tmp/stage2-sdk",
  "source": "discover",
  "userStory": "Create and validate an Aomi app.",
  "shared": false,
  "force": false,
  "build": true,
  "builder": "none",
  "review": false,
  "reviewer": "codex",
  "maxFixRounds": 2,
  "smoke": false,
  "smokePrompt": "List the app capabilities in one paragraph.",
  "deploy": false,
  "autoApprove": false,
  "allowStaleSdk": true,
  "phases": [
    {
      "kind": "compute",
      "id": "binaries",
      "op": "binaries"
    },
    {
      "kind": "loop",
      "id": "hard-loop",
      "until": "eval-pass",
      "maxRounds": 2,
      "onMax": "return-last",
      "body": [
        {
          "kind": "eval",
          "id": "never-eval",
          "scenario": "impossible",
          "rubric": "ok",
          "threshold": 0.7
        }
      ]
    },
    {
      "kind": "compute",
      "id": "result",
      "op": "result"
    }
  ]
}
