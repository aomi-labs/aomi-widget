{
  "app": "gamefi",
  "sdkRoot": "/tmp/stage2-sdk",
  "source": "discover",
  "userStory": "A GameFi companion that reads the player's on-chain + game state",
  "shared": false,
  "force": false,
  "build": true,
  "builder": "none",
  "review": false,
  "reviewer": "codex",
  "maxFixRounds": 2,
  "smoke": false,
  "smokePrompt": "List the app capabilities in one paragraph.",
  "deploy": false,
  "autoApprove": false,
  "allowStaleSdk": true,
  "phases": [
    {
      "kind": "compute",
      "id": "binaries",
      "op": "binaries"
    },
    {
      "kind": "wait-external",
      "id": "await-game-apis",
      "waitingFor": "the game server exposes the companion APIs from DESIGN.md"
    },
    {
      "kind": "loop",
      "id": "integration-loop",
      "until": "eval-pass",
      "maxRounds": 2,
      "onMax": "return-last",
      "body": [
        {
          "kind": "eval",
          "id": "integration-eval",
          "scenario": "ask the companion about my loadout",
          "rubric": "calls the game API",
          "threshold": 0.7
        }
      ]
    },
    {
      "kind": "compute",
      "id": "result",
      "op": "result"
    }
  ]
}
