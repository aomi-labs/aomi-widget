{
  "app": "stage2demo",
  "sdkRoot": "/tmp/stage2-sdk",
  "source": "discover",
  "userStory": "Create and validate an Aomi app.",
  "shared": false,
  "force": false,
  "build": true,
  "builder": "none",
  "review": false,
  "reviewer": "codex",
  "maxFixRounds": 2,
  "smoke": false,
  "smokePrompt": "List the app capabilities in one paragraph.",
  "deploy": false,
  "autoApprove": false,
  "allowStaleSdk": true,
  "phases": [
    {
      "kind": "compute",
      "id": "binaries",
      "op": "binaries"
    },
    {
      "kind": "parallel",
      "id": "fanout",
      "branches": [
        [
          {
            "kind": "eval",
            "id": "eval-a",
            "scenario": "parallel branch a",
            "rubric": "ok",
            "threshold": 0.7
          }
        ],
        [
          {
            "kind": "eval",
            "id": "eval-b",
            "scenario": "parallel branch b",
            "rubric": "ok",
            "threshold": 0.7
          }
        ]
      ]
    },
    {
      "kind": "loop",
      "id": "behavior-loop",
      "until": "eval-pass",
      "maxRounds": 3,
      "onMax": "return-last",
      "body": [
        {
          "kind": "eval",
          "id": "loop-eval",
          "scenario": "loop-eval scenario",
          "rubric": "ok",
          "threshold": 0.7
        }
      ]
    },
    {
      "kind": "compute",
      "id": "result",
      "op": "result"
    }
  ]
}
